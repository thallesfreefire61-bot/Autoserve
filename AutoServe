-- Sistema de Busca de Servidores
local function getServers()
    local servers = {}
    local cursor = ""
    local pagesToScan = 3
    
    for i = 1, pagesToScan do
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end
        
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server)
                end
            end
            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            break
        end
    end
    
    return servers
end

local function hopToServer(serverId)
    statusLabel.Text = "Conectando ao novo servidor..."
    statusLabel.TextColor3 = COLORS.Warning
    
    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, LocalPlayer)
    end)
    
    if not success then
        statusLabel.Text = "Falha no teleporte: " .. tostring(err)
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return false
    end
    return true
end

local function checkAndHop()
    statusLabel.Text = "Buscando servidores disponíveis..."
    statusLabel.TextColor3 = COLORS.SubText
    
    local servers = getServers()
    
    if #servers == 0 then
        statusLabel.Text = "Nenhum servidor encontrado. Tentando novamente..."
        statusLabel.TextColor3 = COLORS.Warning
        return false
    end
    
    local validServers = {}
    for _, server in ipairs(servers) do
        if server.playing >= TARGET_PLAYERS then
            table.insert(validServers, server)
        end
    end
    
    if #validServers > 0 then
        local targetServer = validServers[math.random(1, #validServers)]
        statusLabel.Text = "Servidor encontrado (" .. targetServer.playing .. " jog.)!"
        statusLabel.TextColor3 = COLORS.Success
        return hopToServer(targetServer.id)
    else
        table.sort(servers, function(a, b) return a.playing > b.playing end)
        local bestServer = servers[1]
        
        statusLabel.Text = "Sem servidor com " .. TARGET_PLAYERS .. "+ jog. Melhor: " .. bestServer.playing
        statusLabel.TextColor3 = COLORS.Warning
        
        if AUTO_HOP then
            task.wait(1.5)
            return hopToServer(bestServer.id)
        end
    end
    
    return false
end

